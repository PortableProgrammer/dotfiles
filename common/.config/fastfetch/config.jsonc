{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    //"packages",
    "shell",
    //"display",
    //"de",
    //"wm",
    //"wmtheme",
    //"theme",
    //"icons",
    //"font",
    //"cursor",
    //"terminal",
    //"terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    //"battery",
    //"poweradapter",
    "locale",
    "break",
    "localip",
    //"colors"
    {
      // (Ubuntu) Number of updates available. Ignore ESM updates; get only the first instance of a number in the updates-available file.
      "type": "command",
      "text": "if [ -e /var/lib/update-notifier/updates-available ]; then echo \"$(cat /var/lib/update-notifier/updates-available | egrep -o -m 1 '[0-9]+' | sed -r 's/^([0-9]+)/\\1 updates available/')\"; fi",
      "key": "Updates"
    },
    {
      // (RPI-OS) Number of updates available.
      "type": "command",
      "text": "if [ -e /etc/updates-available ]; then echo \"$(cat /etc/updates-available)\"; fi",
      "key": "Updates"
    },
    {
      // Reboot Required
      "type": "command",
      "text": "if [ -e /var/run/reboot-required ]; then echo \"Yes\"; fi",
      "key": "Reboot Required"
    }
  ]
}